# Copy to .env.local (gitignored) and fill in. Never commit real keys.
#
# Only NEXT_PUBLIC_* values reach the browser, so nothing secret may go there.
# CLERK_SECRET_KEY has no NEXT_PUBLIC_ prefix for exactly that reason.

# Clerk — from the dashboard of the instance you are pointing at.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Where Clerk sends people. Without these it redirects to Clerk's hosted pages
# instead of the ones in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# The backend. Behind Cloudflare in production; http://localhost:8000 for local dev
# against `uvicorn app.main:app --reload`.
NEXT_PUBLIC_API_URL=https://api.brightbhoom.com
