# Copy to .env (gitignored) and fill in. Never commit real secrets.

APP_ENV=local

# Local docker-compose postgres. Prod: the Neon connection string, from a secret.
DATABASE_URL=postgresql+psycopg://club:club@localhost:5432/running_club

# The only origin allowed to call this API (CORS). Never "*".
FRONTEND_URL=http://localhost:3000

# Clerk. Issuer and JWKS URL come from the Clerk dashboard for your instance;
# the webhook secret is shown when you create the endpoint in Clerk.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Bootstrap only: the Clerk user id promoted to superuser by the verified webhook.
# Leave empty in environments that shouldn't have one.
SUPERUSER_CLERK_USER_ID=

# PDPA. Bump CONSENT_VERSION only when the consent wording changes in substance —
# every member is then asked to agree again before health data can be written.
CONSENT_VERSION=v2
HEALTH_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=1825

# Whether the superuser's Excel export carries the sensitive sheets (screening, health
# records, consent, and the มาตรา 26 profile fields). Off until the DPO has been asked
# about a bulk disclosure; the operational sheets export either way, and turning this on
# is one env var with no deploy. It gates the data, not the accounting — every member
# whose data it carries still gets their own audit row, and consent is still required.
HEALTH_EXPORT_ENABLED=false

# Per-member API rate limit. Callers who aren't identified yet are limited by address —
# see TRUST_PROXY below for where that address is read from.
RATE_LIMIT=120/minute
RATE_LIMIT_ENABLED=true

# Cloudflare in front of the API (production only — leave both as-is locally).
#
# CF_ORIGIN_SECRET: a long random string, set here AND in a Cloudflare Transform Rule
#   that adds the request header `CF-Origin-Secret` with the same value. Anything
#   arriving without it went straight to the *.run.app URL, around the WAF, and is
#   refused with 403 (/healthz stays open for Cloud Run's probe). Empty = guard off.
#   Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# TRUST_PROXY: read the caller's address from CF-Connecting-IP instead of the socket.
#   Turn on ONLY together with CF_ORIGIN_SECRET — on a directly reachable origin the
#   header is attacker-controlled and lets anyone slip the rate limit.
CF_ORIGIN_SECRET=
TRUST_PROXY=false

# Object storage. Local MinIO from docker-compose; in production these point at
# Cloudflare R2 instead — same code, different endpoint. Keep the bucket PRIVATE:
# images are served only through short-lived presigned URLs.
S3_BUCKET=running-club-evidence
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
EVIDENCE_URL_TTL_SECONDS=300

# Gemini reads run data off screenshots. Extraction is rate-limited separately because
# every call costs money.
GEMINI_API_KEY=
EXTRACT_RATE_LIMIT=10/minute
