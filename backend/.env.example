# Copy to .env (gitignored) and fill in. Never commit real secrets.

APP_ENV=local

# Local docker-compose postgres. Prod: the Neon connection string, from a secret.
DATABASE_URL=postgresql+psycopg://club:club@localhost:5432/running_club

# The only origin allowed to call this API (CORS). Never "*".
FRONTEND_URL=http://localhost:3000

# Clerk. Issuer and JWKS URL come from the Clerk dashboard for your instance;
# the webhook secret is shown when you create the endpoint in Clerk.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Bootstrap only: the Clerk user id promoted to superuser by the verified webhook.
# Leave empty in environments that shouldn't have one.
SUPERUSER_CLERK_USER_ID=

# PDPA. Bump CONSENT_VERSION only when the consent wording changes in substance —
# every member is then asked to agree again before health data can be written.
CONSENT_VERSION=v1
HEALTH_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=1825

# Per-member API rate limit.
RATE_LIMIT=120/minute
RATE_LIMIT_ENABLED=true

# Object storage. Local MinIO from docker-compose; in production these point at
# Cloudflare R2 instead — same code, different endpoint. Keep the bucket PRIVATE:
# images are served only through short-lived presigned URLs.
S3_BUCKET=running-club-evidence
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
EVIDENCE_URL_TTL_SECONDS=300

# Gemini reads run data off screenshots. Extraction is rate-limited separately because
# every call costs money.
GEMINI_API_KEY=
EXTRACT_RATE_LIMIT=10/minute
